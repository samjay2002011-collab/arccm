                       split_wrapper_id=target_wrapper, target_wrapper_id=target_wrapper)


def combine(conn, account, instance_id, target_instance_id, amount=None, confirmed=False):
    """دمج رصتين من نفس النوع على المسار الرسمي: على batch بأمر moveAmount لخانة
    الوجهة، وعلى مسار mutate القديم بـ update للهدف + تجهيز المصدر.

    السحب على الوجهة بيملاها للحد الأقصى والفضل يفضل في مكانه (نفس سلوك اللعبة) — الحالتين
    متقيستين لايف 2026-10-31، والمجمول بيفضل ثابت. لو المصدر اتفضى بالكامل بيتشال وده
    رجوعه مفيش ليه مسار رسمي (out["undone"]=False).
    """
    if config.DATA_SOURCE != "pioneer":
        return {"executed": False, "error": "direct_read_only", "kind": "combine",
                "detail": DIRECT_BLOCK_DETAIL}
    if not confirmed:
        return {"executed": False, "error": "confirm_required", "kind": "combine",
                "detail": "This writes to the live source — explicit confirmation required."}
    rows = _rows_for(conn, account, [instance_id, target_instance_id])
    aid = str((rows[0].get("asset_id") if rows else "") or "")
    return pioneer_write.combine_attempt(conn, account, instance_id, target_instance_id,
                                         amount=amount, cap=_stack_cap(conn, account, aid))


def swap(conn, account, instance_id, target_instance_id, confirmed=False):
    """تبديل مكان قطعتين على البوابة الرسمية — من غير أي تغيير في الكمية أو المتانة."""
    if config.DATA_SOURCE != "pioneer":
        return {"executed": False, "error": "direct_read_only", "kind": "swap",
                "detail": DIRECT_BLOCK_DETAIL}
    if not confirmed:
        return {"executed": False, "error": "confirm_required", "kind": "swap",
                "detail": "This writes to the live source — explicit confirmation required."}
    return pioneer_write.swap_items(conn, account, instance_id, target_instance_id)


# ------------------------------------------------------------------ كمية بالضبط للشنطة
def fill_takes(stacks, want, cap=0):
    """الخطة اللي توصلّل الرقم بالضبط: رصّات كاملة الأول، والفاضل ينفصل من أقرب رصة أكبر.

    بترجّع [{"instance_id", "amount", "partial"}] أو None لو المتاح كله أقل من الرقم.
    السقف بيقسّم الفاضل chunks ما بتعديش حجم الأكوم، فالشنطة تستقبل رصّتين زي اللعبة
    بالظبط (15 + 2 للرقم 17) بدل ما ترفض قطعة أكبر من الحد.
    """
    pool = [{"instance_id": str(s.get("instance_id") or ""), "amount": int(s.get("amount") or 0)}
            for s in (stacks or []) if str(s.get("instance_id") or "")]
    pool = [s for s in pool if s["amount"] > 0]
    left = int(want or 0)
    if left < 1 or not pool or sum(s["amount"] for s in pool) < left:
        return None
    pool.sort(key=lambda s: (-s["amount"], s["instance_id"]))
    takes = []
    # الرصّة اللي حجمها ما يزيدش عن المطلوب ومكانها هي الأولى: نقلها في طلب واحد
    # أحسن من رصّات صغيرة + فصل من رصّة تانية. قبل كده كان الرصّات الصغيرة (2)
    # بتتملي الأول مع إن رصّة 5 بتغطي الرقم في حركة واحدة.
    best_i, best_cost = -1, None
    for i, s in enumerate(pool):
        if s["amount"] > left:
            continue
        rem = left - s["amount"]
        cost = 0 if rem == 0 else None
        if rem > 0:
            chunk = min(rem, cap) if cap and cap > 1 else rem
            if any(x["amount"] > chunk for x in pool if x is not s):
                cost = 1
        if cost is not None and (best_cost is None or cost < best_cost):
            best_i, best_cost = i, cost
            if cost == 0:
                break
    if best_i >= 0:
        s = pool[best_i]
        takes.append({"instance_id": s["instance_id"], "amount": s["amount"], "partial": False})
        left -= s["amount"]
        s["amount"] = 0
    for s in pool:
        if left <= 0:
            break
        if s["amount"] <= left and s["amount"] > 0:
            takes.append({"instance_id": s["instance_id"], "amount": s["amount"], "partial": False})
            left -= s["amount"]
            s["amount"] = 0     # الرصة اتنقلت كلها: مابقاش فيها حاجة تتفصل
    while left > 0:
        chunk = min(left, cap) if cap and cap > 1 else left
        # أقرب رصة للقطعة المطلوبة: بنفضّي أصغر رصة ممكنة عشان الكبيرة تفضل سليمة
        cands = [s for s in pool if s["amount"] > chunk]
        if not cands:
            return None
        s = min(cands, key=lambda x: (x["amount"], x["instance_id"]))
        takes.append({"instance_id": s["instance_id"], "amount": chunk, "partial": True})
        s["amount"] -= chunk
        left -= chunk
    return takes


def _merge_undo(dst, cells):
    """حالة الخانات الأصلية من خطوات كتابة كتير: أول قراية لكل خانة هي الصح."""
    for cell, kids in (cells or {}).items():
        dst.setdefault(cell, kids)
    return dst


def _merge_backpack(conn, account, asset_id, cap, keep_id="", max_rounds=8):
    """يجمع قطع النوع الواحد اللي في الشنطة في كومة واحدة على البوابة.

    السحب بيفصل القطع في خانات ورا بعضها (الرصّات الكاملة الأول والقطعة المفصولة
    بعدها)، فلو الطلب 2 بيوصلوا قطعتين 1 + 1. الدمج الحقيقي مفتوح على مسار
    batch-operation (moveAmount لمعرّف كومة موجودة) — نفس اللي في زر MERGE —
    فبنستخدمه على اللي وصل للشنطة بدل ما نستنى اللعبة تلمّها.

    بيرجّع {"merged": عدد الدمجات الناجحة, "id": معرّف الكومة النهائية,
            "amount": كميتها, "detail": آخر رسالة} — ومابيرميش استثناء أبداً:
    فشل الدمج مش فشل للسحبة، القطع موجودة بس في خانات منفصلة.
    """
    merged, last_id, last_amount, detail = 0, "", 0, ""
    aid = str(asset_id or "")
    for _ in range(max(1, int(max_rounds))):
        try:
            data = pc.fetch_inventory_for(account) or {}
            tree = pioneer_tree.Tree(data.get("items") or [])
            lay = pioneer_tree.layout(tree)
        except Exception:
            break
        bag_cells = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                        for s in lay["backpack"]["slots"])
        piles = []
        for iid, node in tree.by_id.items():
            if str(node.get("gameAssetId")) != aid or node.get("slots"):
                continue
            if tree.parent.get(iid, "") not in bag_cells:
                continue
            piles.append({"id": iid, "amount": int(node.get("amount") or 0)})
        piles = [p for p in piles if p["amount"] > 0]
        if len(piles) < 2:
            if piles:
                last_id, last_amount = piles[0]["id"], piles[0]["amount"]
            break
        piles.sort(key=lambda p: (-p["amount"], p["id"] != keep_id, p["id"]))
        tgt, src = piles[0], piles[1]
        take = src["amount"]
        if cap and cap > 1:
            take = min(take, int(cap) - tgt["amount"])
        if take < 1:
            # الكومة الكبيرة مليانة للسقف: الدمج التالي على أحدث كومة أقل من السقف.
            rest = [p for p in piles[1:] if not cap or p["amount"] < int(cap)]
            if len(rest) < 2:
                last_id, last_amount = tgt["id"], tgt["amount"]
                break
            rest.sort(key=lambda p: (-p["amount"], p["id"]))
            tgt, src = rest[0], rest[1]
            take = min(src["amount"], int(cap) - tgt["amount"]) if cap else src["amount"]
            if take < 1:
                last_id, last_amount = tgt["id"], tgt["amount"]
                break
        out = pioneer_write.combine_attempt(conn, account, src["id"], tgt["id"],
                                            amount=take, cap=cap)
        detail = out.get("detail") or ""
        if not out.get("executed"):
            break
        merged += 1
        last_id = tgt["id"]
        last_amount = int((out.get("after") or {}).get("target") or (tgt["amount"] + take))
    if not last_id:
        try:
            data = pc.fetch_inventory_for(account) or {}
            tree = pioneer_tree.Tree(data.get("items") or [])
            lay = pioneer_tree.layout(tree)
            bag_cells = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                            for s in lay["backpack"]["slots"])
            best = [i for i, n in tree.by_id.items()
                    if str(n.get("gameAssetId")) == aid
                    and tree.parent.get(i, "") in bag_cells]
            if best:
                last_id = best[0]
                last_amount = int(tree.by_id[last_id].get("amount") or 0)
        except Exception:
            pass
    return {"merged": merged, "id": last_id, "amount": last_amount, "detail": detail}


_IN_USE = set()
_USE_LOCK = threading.Lock()


class _FillBusy(Exception):
    pass


@contextlib.contextmanager
def _fill_slot(account):
    """قفل الحساب: ضغطتين ورا بعض على نفس الحساب مش بيمشوا متوازيين على البوابة."""
    with _USE_LOCK:
        if account in _IN_USE:
            raise _FillBusy()
        _IN_USE.add(account)
    try:
        yield
    finally:
        with _USE_LOCK:
            _IN_USE.discard(account)


def _fill_pace():
    """فاصل هادي بين طلبات الكتابة على البوابة (400-500ms مختلطين)."""
    time.sleep(random.uniform(0.4, 0.5))


def fill_plan(stacks, want, cap=0):
    """خطة QTY بالظبط: أكوام كاملة الأول، والباقي rem تغطيه كومة واحدة.

    الرصّة المغطية بتتنقل كاملة للشنطة وتتفصل جوّاها: بيفضل منها cover - rem في
    الشنطة وقطعة rem في خانة تانية. يعني Person ده محتاج 3 خانات في الشنطة
    (المغطية + المتبقي + المنفصل) ومش محتاج ولا خانة في الستاش زي قبل كده.
    """
    pool = [{"instance_id": str(s.get("instance_id") or ""), "amount": int(s.get("amount") or 0)}
            for s in (stacks or []) if str(s.get("instance_id") or "")]
    pool = [s for s in pool if s["amount"] > 0]
    left = int(want or 0)
    if left < 1 or not pool or sum(s["amount"] for s in pool) < left:
        return None
    pool.sort(key=lambda s: (-s["amount"], s["instance_id"]))
    full, used = [], set()
    for s in pool:
        if s["amount"] <= left:
            full.append(s)
            used.add(s["instance_id"])
            left -= s["amount"]
            if left == 0:
                break
    cover, rem, split = None, left, False
    if left > 0:
        cands = [s for s in pool if s["instance_id"] not in used and s["amount"] > left]
        if not cands:
            return None
        cover = min(cands, key=lambda s: (s["amount"], s["instance_id"]))
        rem = left
        split = int(cover["amount"]) > rem
    cells = len(full)
    if cover:
        cells += 1
        if split:
            cells += 1 + (1 if int(cap or 0) and rem > int(cap) else 0)
    return {"full": full, "cover": cover, "rem": rem, "split": split, "cells": cells}


def _fill_read(conn, account, asset_id, want, in_bag):
    """قراية حية وتحديد أكوام النوع ده في الستاش/الأوفر وخانات الشنطة الفاضية."""
    data = pc.fetch_inventory_for(account)
    tree = pioneer_tree.Tree((data or {}).get("items") or [])
    lay = pioneer_tree.layout(tree)
    stash_cells = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                      for s in lay["stash"]["slots"])
    bag_cells = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                    for s in lay["backpack"]["slots"])
    out = {"data": data, "tree": tree, "lay": lay, "stash_cells": stash_cells,
           "free": [], "stacks": [], "pieces": [], "in_bag": 0}
    for cell in bag_cells:
        if not tree.first_child(cell):
            out["free"].append(str(cell))
    bag_items = set()
    for cell in bag_cells:
        bag_items.update(tree.children(cell))
    for iid, node in tree.by_id.items():
        if str(node.get("gameAssetId")) != str(asset_id or ""):
            continue
        par = tree.parent.get(iid, "")
        qty = int(node.get("amount") or 0)
        if qty < 1:
            continue
        if par in bag_cells or iid in bag_items:
            out["in_bag"] += qty
            continue
        if par and par not in stash_cells:
            continue
        entry = {"instance_id": iid, "amount": qty,
                 "container": "stash" if par else "overflow",
                 "cell": str(par or ""), "name": tree.name_of(iid)}
        if qty > 1 and not node.get("slots"):
            out["stacks"].append(entry)
        else:
            out["pieces"].append(entry)
    if not out["in_bag"]:
        out["in_bag"] = in_bag
    return out


def _fill_plan_of(found, want, cap):
    single = [s for s in found["stacks"] if s["amount"] <= 1]
    stacks = [s for s in found["stacks"] if s["amount"] > 1]
    need = max(0, want - found["in_bag"])
    loose, want_left = [], need
    for p in found["pieces"]:
        if want_left <= 0:
            break
        loose.append(p)
        want_left -= p["amount"]
    plan = fill_plan(stacks, want_left, cap)
    if plan is None:
        return {"stacks": stacks, "single": single, "loose": loose, "plan": None,
                "need": need, "short": want_left}
    short = want_left - (sum(t["amount"] for t in plan["full"]) +
                         (plan["rem"] if plan["cover"] else 0))
    if short > 0 and single:
        # رصّات الـ 1 مش مصادر فصل: بتتاخد هي نفسها كقطعة كاملة.
        single.sort(key=lambda s: (-s["amount"], s["instance_id"]))
        extra = single[:short]
        if extra:
            plan["cover"].pop("needs_space", None)
        plan["full"] = plan["full"] + [dict(s) for s in extra]
        plan["cells"] += len(extra)
        short -= len(extra)
    return {"stacks": stacks, "single": single, "loose": loose, "plan": plan,
            "need": need, "short": short}


def _fill_verify(conn, account, asset_id, name, before, in_bag, steps, undo, plan):
    """التحقق النهائي وخطوة WAN: SYNC واحد، ونوع الإجمالي ثابت والشنطة فيها الرقم بالظبط."""
    aid = str(asset_id)
    after = pc.fetch_inventory_for(account) or {}
    tree = pioneer_tree.Tree((after or {}).get("items") or [])
    now_total = pioneer_write._asset_totals(tree).get(aid, 0)
    bag_cells = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                    for s in pioneer_tree.layout(tree)["backpack"]["slots"])
    bag_count = 0
    for iid, node in tree.by_id.items():
        if str(node.get("gameAssetId")) == aid and tree.parent.get(iid, "") in bag_cells:
            bag_count += int(node.get("amount") or 0)
    same = now_total == before
    sync = {"ok": False, "detail": ""}
    _fill_pace()
    try:
        sync = synchronize(conn, account) or {}
    except Exception as exc:
        sync = {"ok": False, "detail": str(exc)[:200]}
    return {"executed": True, "kind": "fill", "delivered": bag_count - in_bag,
            "in_backpack": bag_count, "total_before": before, "total_after": now_total,
            "same_total": same, "plan": plan, "steps": steps, "undo": {"cells": undo},
            "sync": bool(sync.get("ok")), "refreshed": None,
            "detail": "%d %s in the backpack (was %d); the type total is %s." % (
                bag_count, name, in_bag,
                ("still %d" % before) if same else "CHANGED from %d to %d" % (before, now_total))}


def _fill_verified(conn, account, asset_id, want, confirmed):
    """تنفيذ QTY على المسارات الرسمية للبوابة:
      1) فحص الخانات قبل أي كتابة — ناقصة = رفض فوري برسالة عدد الخانات.
      2) أكوام كاملة في طلب واحد.
      3) كومة المغطية كاملة لخانة فاضية في الشنطة.
      4) الفصل الرسمي جوّه الشنطة (قطعة rem في خانة كمان).
      5) قطع الباقي لو كانت مطلوبة.
      6) SYNC واحد في الآخر.
    """
    aid = str(asset_id)
    try:
        found = _fill_read(conn, account, aid, want, 0)
    except pc.TokenExpired as exc:
        return {"executed": False, "error": "token_expired", "kind": "fill", "detail": str(exc)}
    except pc.PioneerError as exc:
        return {"executed": False, "error": "gateway_error", "kind": "fill",
                "detail": str(exc)[:300]}
    try:
        name = next((s["name"] for s in found["stacks"] + found["pieces"] if s.get("name")), aid)
        total = found["in_bag"] + sum(s["amount"] for s in found["stacks"]) + \
            sum(p["amount"] for p in found["pieces"])
        if total < want:
            return {"executed": False, "error": "not_in_stash", "kind": "fill",
                    "detail": "All you have of %s in the stash and overflow is %d, so %d is "
                              "impossible." % (name, total, want)}
        if found["in_bag"] == want:
            return {"executed": False, "error": "already_in_backpack", "kind": "fill",
                    "detail": "The backpack already holds %d %s, so there is nothing to move." % (
                        found["in_bag"], name)}
        cap = _stack_cap(conn, account, aid)
        before = pioneer_write._asset_totals(found["tree"]).get(aid, 0)
        calc = _fill_plan_of(found, want, cap)
        plan = calc["plan"]
        if found["in_bag"] > want:
            # الشنطة فيها أكتر من المطلوب: نفس المحرك بيمسك الستاكات اللي جوّه الشنطة
            # ويخلّي المطلوب بالظبط ويرجّع الزيادة للستاش.
            if plan is None:
                calc["short"] = want
            else:
                plan["group"] = True
        if plan is None or calc["short"] > 0:
            return {"executed": False, "error": "not_enough", "kind": "fill", "plan": plan,
                    "detail": "Your full stacks add up to %d %s and no single stack covers "
                              "the rest; pick a smaller QTY." % (total, name)}
        need = (plan["cells"] if plan else 0) + len(calc["loose"])
        if len(found["free"]) < need:
            return {"executed": False, "error": "no_room", "kind": "fill", "plan": plan,
                    "cells_needed": need, "cells_free": len(found["free"]),
                    "detail": "The backpack has %d free cells and this move needs %d. Make room "
                              "first." % (len(found["free"]), need)}
        if not confirmed:
            return {"executed": False, "error": "confirm_required", "kind": "fill", "plan": plan,
                    "detail": "This writes to the live source — explicit confirmation required."}
        if pioneer_write.paused():
            return {"executed": False, "error": "write_paused", "code": 423, "kind": "fill",
                    "plan": plan, "detail": pioneer_write.PAUSE_DETAIL}
    except Exception as exc:
        return {"executed": False, "error": "bad_tree", "kind": "fill", "detail": str(exc)[:300]}

    steps, undo = [], {}
    with _fill_slot(account):
        try:
            return _fill_steps(conn, account, found, aid, name, cap, before, calc, steps, undo)
        except pc.TokenExpired as exc:
            return {"executed": False, "error": "token_expired", "kind": "fill",
                    "plan": plan, "steps": steps, "detail": str(exc)}
        except pc.PioneerError as exc:
            return {"executed": False, "error": "gateway_error", "kind": "fill",
                    "plan": plan, "steps": steps, "detail": str(exc)[:300]}
        except pioneer_tree.TreeError as exc:
            return {"executed": False, "error": exc.error, "kind": "fill",
                    "plan": plan, "steps": steps, "detail": exc.detail}


def _fill_where(snap, iid, cells):
    """(أقرب أب معروف للقطعة، هل هي جوّه الشنطة) — بالطلوع في أباء الشجرة الحية."""
    if snap is None or not iid or str(iid) not in snap.by_id:
        return "", False
    cur = str(iid)
    for _ in range(12):
        par = str(snap.parent.get(cur) or "")
        if not par:
            return "", False
        if cur in cells or par in cells:
            return (cur if cur in cells else par), True
        if par not in snap.by_id:
            return par, False
        cur = par
    return "", False


def _fill_steps(conn, account, found, aid, name, cap, before, calc, steps, undo):
    """QTY من الستاش: الأكوام الكاملة تتنقل في طلب واحد، والمغطية كاملة لخانة فاضية،
    وبعدها الفصل الرسمي جوّه الشنطة، والزيادة اللي طلعت من الفصل بترجع للستاش
    (ولو البوابة رفضت الستاش بتتحول للأوفر ستاش).

    كل خطوة بتتحقق من الشجرة الحية بعدها بدل ما تثق في رد البوابة: الستاك لازم يظهر
    في الشنطة، وقطعة الزيادة لازم تظهر برّه خانتها — وأي فشل في الرجوع بيطلع نص
    البوابة الحرفي في رسالة ✗ بدل ما يعدي بصمت."""
    plan = calc["plan"]
    full, cover, rem = plan["full"], plan["cover"], plan["rem"]
    src = ""
    seen = []
    touched = set()
    budget = 3 + max(0, sum(1 for s in calc["stacks"] if s["amount"] > 1))

    def live():
        after = pc.fetch_inventory_for(account) or {}
        snap = pioneer_tree.Tree(after.get("items") or [])
        lay = pioneer_tree.layout(snap)
        cells = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                    for s in lay["backpack"]["slots"])

        def total():
            return pioneer_write._asset_totals(snap).get(aid, 0)

        def inside(iid):
            where, is_in = _fill_where(snap, iid, cells)
            amt = int((snap.by_id.get(str(iid)) or {}).get("amount") or 0) \
                if str(iid) in snap.by_id else 0
            return is_in, amt

        def bags():
            """(الكمية اللي في الشنطة، [(instance_id, amount)] للقطع اللي جوّه الشنطة).

            الرصة اللي البوابة رجّعتها من الفصل من غير gameAssetId مش بتتحسب في مجموع
            النوع (مقيس لايف)، فبتتقري هنا من أب المصدر: أي رصة جوّه الشنطة بعمر جديد
            جنب المصدر بتبقى من نفس الطلب."""
            rows = []
            for c in cells:
                for kid in snap.kids.get(c) or []:
                    node = snap.by_id.get(kid) or {}
                    same_src = str(snap.parent.get(kid) or "") == str(snap.parent.get(src) or "")
                    if str(node.get("gameAssetId")) == aid or \
                            (not node.get("gameAssetId") and same_src and same_src in cells
                             and kid != src):
                        rows.append((kid, int(node.get("amount") or 0)))
            loose = list(rows)
            for r in seen:
                if r[0] not in [k for k, _a in rows]:
                    loose.append(r)
            return sum(a for _, a in rows), rows, loose
        snap.total, snap.inside, snap.bags = total, inside, bags
        return snap, cells

    def back(rows):
        for r in reversed(rows):
            _fill_pace()
            res = pioneer_write.move(conn, account, "stash", [{"instance_id": r["instance_id"]}])
            if not res.get("executed"):
                _fill_pace()
                res = pioneer_write.move(conn, account, "overflow", [{"instance_id": r["instance_id"]}])
            steps.append({"action": "move", "what": "back", "items": 1,
                          "executed": bool(res.get("executed")), "error": res.get("error"),
                          "detail": res.get("detail")})

    def stop(msg, rows=None):
        if rows:
            back(rows)
        return {"executed": False, "kind": "fill", "error": "move_failed", "plan": plan,
                "steps": steps, "undo": {"cells": undo}, "detail": msg}

    for _ in range(budget):
        try:
            snap, cells = live()
            free = [c for c in cells if not snap.first_child(c)]
        except Exception:
            snap, cells, free = found["tree"], set(), list(found["free"])
        path, left = [], rem
        if __import__("os").environ.get("FILL_DEBUG"):
            print("FILLDBG iter=%r rem=%r left=%r full=%r cover=%r group=%r" % (
                _, rem, left, full, cover, plan.get("group")), flush=True)
        if plan.get("group"):
            # الستاكات اللي جوّه الشنطة هي المصدر: الكبيرة الأول، وآخرها اللي بتتغطى
            # (الزيادة بتتفصل منها جوّه الشنطة وترجع للستاش). كل واحد جوّه خانته
            # فمفيش نقل قبل الفصل.
            bag_stacks = sorted((list(r) for r in snap.bags()[1]), key=lambda r: -int(r[1]))
            for iid, amt in bag_stacks:
                if left <= 0:
                    break
                take = min(int(amt), left)
                path.append([{"instance_id": iid, "amount": int(amt)}, take,
                             take < int(amt)])
                left -= take
        else:
            order = sorted(full, key=lambda s: (s["instance_id"] in touched, -int(s["amount"])))
            if __import__("os").environ.get("FILL_DEBUG"):
                print("FILLDBG order=%r left=%r" % (order, left), flush=True)
            for f in order:
                if left <= 0:
                    break
                take = min(int(f["amount"]), left)
                path.append([f, take, take < int(f["amount"])])
                left -= take
        if left > 0 and cover and not cover.get("touches"):
            take = min(int(cover["amount"]), left)
            path.append([cover, take, take < int(cover["amount"])])
            left -= take
        if left > 0:
            return {"executed": False, "kind": "fill", "error": "not_enough", "plan": plan,
                    "steps": steps, "undo": {"cells": undo},
                    "detail": "The full stacks add up to less than the QTY and no single stack "
                              "covers the rest; pick a smaller QTY."}
        moved, failed = [], ""
        for entry in path:
            f, take, part = entry
            if part and not plan.get("group"):
                if not free:
                    failed = "The covering stack has no free cell — make room and try again."
                    break
                own, free = free[0], free[1:]
                body = [{"instance_id": f["instance_id"], "target_wrapper_id": own}]
            elif part:
                body = [{"instance_id": f["instance_id"],
                         "target_wrapper_id": str(snap.parent.get(f["instance_id"]) or "")}]
            else:
                body = [{"instance_id": f["instance_id"]}]
            _fill_pace()
            out = pioneer_write.move(conn, account, "backpack", body)
            _merge_undo(undo, (out.get("undo") or {}).get("cells"))
            ok = bool(out.get("executed"))
            why = out.get("detail") or out.get("error") or "the gateway did not answer"
            if ok:
                # الرد مش دليل: الستاك لازم يظهر جوّه الشنطة في الشجرة الحية.
                snap, cells = live()
                is_in, _amt = snap.inside(f["instance_id"])
                if not is_in:
                    where, _x = _fill_where(snap, f["instance_id"], cells)
                    ok = False
                    why = "the gateway answered OK but the stack is not shown inside the " \
                          "backpack (%s)" % (where or "nowhere")
            steps.append({"action": "move", "what": "cover" if part else "full", "items": 1,
                          "amount": take, "executed": ok, "error": out.get("error"),
                          "detail": out.get("detail")})
            if not ok:
                failed = "%s: %s" % ("The covering stack did not enter the backpack" if part
                                     else "The full stacks did not all move", why)
                break
            entry[0] = dict(f, cell=str(snap.parent.get(f["instance_id"]) or ""))
            moved.append({"instance_id": f["instance_id"]})
            touched.add(f["instance_id"])
        if failed:
            return stop(failed, moved)
        split_row = next((e for e in path if e[2]), None)
        if not split_row:
            return _fill_verify(conn, account, aid, name, before, found["in_bag"], steps, undo,
                                plan)
        f, take, _part = split_row
        src = f["instance_id"]
        if take >= int(f["amount"]):
            return _fill_verify(conn, account, aid, name, before, found["in_bag"], steps, undo,
                                plan)
        # الفصل لازم يقع في مسار الشنطة؛ لو سبق وفصلنا (مستوى واحد) بنكمل من القراية.
        snap, cells = live()
        own = str(snap.parent.get(src) or "")
        sibs = [t for t in snap.children(own) if t != src]
        if sibs:
            spare = [c for c in cells if not snap.first_child(c)]
            if not spare:
                return stop("The covering stack shares its cell with another stack and the "
                            "backpack has no free cell to move that one out.", moved)
            _fill_pace()
            out = pioneer_write.move(conn, account, "backpack",
                                     [{"instance_id": sibs[0], "target_wrapper_id": spare[0]}])
            steps.append({"action": "move", "what": "clear-cell", "items": 1,
                          "executed": bool(out.get("executed")), "error": out.get("error"),
                          "detail": out.get("detail")})
            if not out.get("executed"):
                return stop("The stack sharing the covering cell could not move out: %s"
                            % (out.get("detail") or "the gateway did not answer"), moved)
            touched.update(sibs)
        snap, cells = live()
        before = snap.total()
        before_rows = snap.bags()[1]
        _fill_pace()
        sp = pioneer_write.split_attempt(conn, account, src, "", take, cap=cap, into_cell=False)
        steps.append({"action": "split", "instance_id": src, "amount": take,
                      "executed": bool(sp.get("executed")), "error": sp.get("error"),
                      "detail": sp.get("detail")})
        piece = sp.get("created") if sp.get("executed") else ""
        if not piece and (sp.get("executed") or sp.get("same_total")):
            try:
                snap, cells = live()
                sib = [t for t in snap.children(src) if t != src and t not in touched]
                piece = sib[0] if sib else ""
            except Exception:
                piece = ""
        if not piece and src in (snap.by_id if snap is not None else {}):
            # الرد مش دليل: لو كميات النوع وتوزيعها اتغيّر في الشجرة الحية يبقى الفصل
            # حصل (ولو الرد مارجّعش الآيدي) — بنمشي على الزيادة الحقيقية اللي في الشنطة.
            bag_total, bag_rows, bag_loose = snap.bags()
            changed = bag_total != before or set(bag_rows) != set(before_rows)
            piece = "shapes" if changed else ""
        if not piece:
            # الرصة الجديدة بترجع بلا gameAssetId: بتتقري من خانة المصدر (جنبه).
            snap, cells = live()
            piece = next((k for k in snap.children(str(snap.parent.get(src) or ""))
                          if k != src and k not in touched and not snap.by_id[k].get("gameAssetId")),
                         "")
        if not piece:
            return stop("The covering stack is in the backpack but the exact split stopped: %s"
                        % (sp.get("detail") or "the split did not execute"), moved)
        # القطعة اللي طلعت من الفصل مش مضمون إنها هي الزيادة: البوابة ساعات بتفصل
        # جوّه خانة واحدة (القطعة والمصدر سوّا). فبنقرا الشجرة الحية من غير افتراضات:
        # الزيادة = اللي جوّه الشنطة ناقص المطلوب، والرجّع بيتم من القطع اللي برّه خانة
        # المصدر الأول — وكل رجعة بتتحقق (الإجمالي ثابت والقطعة برّه الشنطة).
        snap, cells = live()
        bag_total, bag_rows, bag_loose = snap.bags()
        spent = 0

        def loc(cell):
            # (الحاوية اللي الخانة جواها، هل هي خانة شنطة)
            if cell in cells:
                return "backpack", True
            return _fill_where(snap, cell, cells)

        while bag_total > rem and spent < 6:
            leftover = bag_total - rem
            bags_src = [r[0] for r in bag_rows if not snap.by_id.get(r[0], {}).get("gameAssetId")]
            src = str(bags_src[0]) if bags_src else ""
            # الصفوف = اللي في خانات الشنطة + أي قطعة فصلناها إحنا وهي على الشجيرة الحية
            # (بعض الرصّات بترجع من الفصل من غير gameAssetId ولا أب معروف).
            kid_cell = dict((kid, str(c)) for c in cells for kid in snap.kids.get(c) or [])
            rows = []
            for kid, amt in bag_loose:
                cell = kid_cell.get(kid) or str(snap.parent.get(kid) or "")
                if not cell:
                    continue
                node = snap.by_id.get(kid) or {}
                if str(node.get("gameAssetId")) == aid or kid in [s[0] for s in seen]:
                    rows.append((kid, int(amt), cell))
            spare_cells = [c for c in cells if not snap.first_child(c)]
            if not rows:
                return stop("The type could not be read inside the backpack after the split.",
                            moved)
            row_cells = dict((i, c) for i, a, c in rows)
            big = max([r for r in rows if int(r[1]) > leftover],
                      key=lambda r: (int(r[1]), r[0]), default=rows[0])
            initial_kids = set(snap.children(row_cells[big[0]]))
            # القطعة اللي برّه خانة المصدر: بنحوّل الزيادة من اللي في خانة المصدر نفسه.
            outside = [(i, a) for i, a, c in rows
                       if int(a) <= leftover and _fill_where(snap, i, cells)[0] != big[2]]
            if outside:
                outside.sort(key=lambda r: (int(r[1]), r[0]))
                pid, amt = outside[0]
                moving = amt if amt <= leftover else leftover
            else:
                # مفيش قطعة زيادة لوحدها: الزيادة بتتفصل رسمي من أكبر رصة جوّه الشنطة
                # (سواء المصدر أو اللي معاه في خانته).
                if int(big[1]) <= leftover:
                    return stop("The backpack holds %d and every stack is smaller than the "
                                "excess of %d, so the gateway cannot split it apart."
                                % (bag_total, leftover), moved)
                ref = big[0]
                _fill_pace()
                before_total = snap.total()
                what = pioneer_write.split_attempt(conn, account, ref, "", leftover, cap=cap,
                                                   into_cell=False)
                steps.append({"action": "split", "instance_id": ref, "amount": leftover,
                              "executed": bool(what.get("executed")),
                              "error": what.get("error"), "detail": what.get("detail")})
                snap, cells = live()
                fresh = what.get("created") if what.get("executed") else ""
                if not fresh:
                    # الرد مارجّعش آيدي (الرصة الجديدة ساعات بترجع بلا gameAssetId):
                    # القطعة الجديدة بتقع جنب المصدر في خانته.
                    fresh = next((k for k in snap.children(str(snap.parent.get(ref) or ""))
                                  if k != ref and k not in initial_kids), "")
                if not fresh:
                    try:
                        for _ in range(3):
                            _fill_pace()
                            snap, cells = live()
                            fresh = next((k for c in cells for k in (snap.kids.get(c) or [])
                                          if k not in touched and k != ref
                                          and int((snap.by_id.get(k) or {}).get("amount") or 0)
                                          == leftover
                                          and str((snap.by_id.get(k) or {}).get("gameAssetId"))
                                          in (aid, "", "0", "None")), "")
                            if fresh:
                                break
                    except Exception:
                        fresh = ""
                if not fresh:
                    return stop("The excess piece could not be split off the stack it shares a "
                                "cell with: %s" % (what.get("detail") or "the split did not "
                                                   "execute"), moved)
                pid, amt, moving = fresh, leftover, leftover
                seen.append((fresh, leftover))
            before_total = snap.total()
            _fill_pace()
            out = pioneer_write.move(conn, account, "stash",
                                     [{"instance_id": pid, "amount": moving}])
            steps.append({"action": "move", "what": "excess-stash", "items": 1,
                          "amount": moving, "executed": bool(out.get("executed")),
                          "error": out.get("error"), "detail": out.get("detail")})
            snap, cells = live()
            done = bool(out.get("executed")) and snap.inside(pid)[0] is False
            if not done:
                _fill_pace()
                out = pioneer_write.move(conn, account, "overflow",
                                         [{"instance_id": pid, "amount": moving}])
                steps.append({"action": "move", "what": "excess-overflow", "items": 1,
                              "amount": moving, "executed": bool(out.get("executed")),
                              "error": out.get("error"), "detail": out.get("detail")})
                snap, cells = live()
                done = bool(out.get("executed")) and snap.inside(pid)[0] is False
                if not done:
                    return stop("The excess piece was split but did not leave the backpack: %s"
                                % (out.get("detail") or out.get("error")
                                   or "the gateway did not answer"), moved)
            if snap.total() != before_total:
                return stop("⚠️ The total of the type changed while the excess piece was going "
                            "back — check the stash in the game before any other move.", moved)
            bag_total, bag_rows, bag_loose = snap.bags()
            spent += 1
        if bag_total > rem:
            return stop("The backpack still holds %d and the gateway would not take the rest "
                        "back (wanted %d)." % (bag_total, rem), moved)
        return _fill_verify(conn, account, aid, name, before, found["in_bag"], steps, undo, plan)
    return {"executed": False, "kind": "fill", "error": "full_stacks", "plan": plan,
            "steps": steps, "undo": {"cells": undo},
            "detail": "The backpack's stacks could not be arranged into one clean covering "
                      "stack; nothing else was touched."}


def fill(conn, account, asset_id, want, target_wrapper="", confirmed=False):
    """يوصلّل الرقم المطلوب للشنطة بالظبط (QTY → MOVE TO BACKPACK).

    الرقم بيتقرا من الشجرة الحية، والخانات بتتحسب قبل أي كتابة. لو الخانات ناقصة
    الطلب بيترفض قبل ما يتلمس أي حاجة، ولو خطوة فشلت في النص بيرجع اللي اتسمع
    لحد ما وقف — مفيش كتابة هيكلية يدوية، كله نقل وفصل رسمي على البوابة.
    """
    if config.DATA_SOURCE != "pioneer":
        return {"executed": False, "error": "direct_read_only", "kind": "fill",
                "detail": DIRECT_BLOCK_DETAIL}
    if account == "ALL":
        return {"executed": False, "error": "pick_account", "detail": "Pick one account first."}
    if not asset_id:
        return {"executed": False, "error": "nothing_selected", "kind": "fill",
                "detail": "Select one item type in the search first."}
    try:
        want = int(want)
    except (TypeError, ValueError):
        want = 0
    if want < 1:
        return {"executed": False, "error": "bad_amount", "kind": "fill",
                "detail": "Type a number in the QTY field first."}
    try:
        return _fill_verified(conn, account, asset_id, want, confirmed)
    except _FillBusy:
        return {"executed": False, "error": "busy", "kind": "fill", "code": 409,
                "detail": "Another QTY move is already running on this account; wait for it "
                          "to finish."}
def synchronize(conn, account):
    if config.DATA_SOURCE == "pioneer":
        if account == "ALL":
            return {"executed": False, "error": "pick_account", "detail": "Pick one account to sync."}
        pulled = sync.pull_account(conn, account, None, with_assets=False)
        store.log_action(conn, account, "sync:direct", {"source": "pioneer"},
                         "executed" if pulled.get("ok") else "failed",
                         pulled.get("error") or {"items": pulled.get("items")}, 0)
        return {"executed": bool(pulled.get("ok")), "result": {"ok": True, "mode": "pioneer"},
                "refreshed": pulled, "note": "Sync came straight from the game gateway — no data went through rampart."}
    if account == "ALL":
        return {"executed": False, "error": "pick_account", "detail": "Pick one account to sync."}
    acc_id = _account_id(conn, account)
    if not acc_id:
        return {"executed": False, "error": "pick_account", "detail": "This account is not linked on Rampart."}
    try:
        outcome = writer.sync_upstream(acc_id)
    except Exception as exc:
        outcome = {"ok": False, "code": 502, "error": "upstream_error", "detail": str(exc)[:300]}
    store.log_action(conn, account, "synchronize",
                     {"method": "POST", "url": writer.SYNC},
                     "executed" if outcome.get("ok") else outcome.get("error", "failed"),
                     outcome.get("response") or outcome.get("detail"), 0)
    pulled = None
    if outcome.get("ok"):
        pulled = sync.pull_account(conn, account, acc_id, with_assets=False)
        if pulled and pulled.get("ok"):
            store.set_meta(conn, "stats:%s" % account, pulled.get("stats") or {})
            conn.execute("UPDATE accounts SET last_sync=? WHERE id=?", (time.time(), acc_id))
            conn.commit()
    return {"executed": bool(outcome.get("ok")), "result": outcome, "refreshed": pulled}
