                       split_wrapper_id=target_wrapper, target_wrapper_id=target_wrapper)


def combine(conn, account, instance_id, target_instance_id, amount=None, confirmed=False):
    """دمج رصتين من نفس النوع على المسار الرسمي: على batch بأمر moveAmount لخانة
    الوجهة، وعلى مسار mutate القديم بـ update للهدف + تجهيز المصدر.

    السحب على الوجهة بيملاها للحد الأقصى والفضل يفضل في مكانه (نفس سلوك اللعبة) — الحالتين
    متقيستين لايف 2026-10-31، والمجمول بيفضل ثابت. لو المصدر اتفضى بالكامل بيتشال وده
    رجوعه مفيش ليه مسار رسمي (out["undone"]=False).
    """
    if config.DATA_SOURCE != "pioneer":
        return {"executed": False, "error": "direct_read_only", "kind": "combine",
                "detail": DIRECT_BLOCK_DETAIL}
    if not confirmed:
        return {"executed": False, "error": "confirm_required", "kind": "combine",
                "detail": "This writes to the live source — explicit confirmation required."}
    rows = _rows_for(conn, account, [instance_id, target_instance_id])
    aid = str((rows[0].get("asset_id") if rows else "") or "")
    return pioneer_write.combine_attempt(conn, account, instance_id, target_instance_id,
                                         amount=amount, cap=_stack_cap(conn, account, aid))


def swap(conn, account, instance_id, target_instance_id, confirmed=False):
    """تبديل مكان قطعتين على البوابة الرسمية — من غير أي تغيير في الكمية أو المتانة."""
    if config.DATA_SOURCE != "pioneer":
        return {"executed": False, "error": "direct_read_only", "kind": "swap",
                "detail": DIRECT_BLOCK_DETAIL}
    if not confirmed:
        return {"executed": False, "error": "confirm_required", "kind": "swap",
                "detail": "This writes to the live source — explicit confirmation required."}
    return pioneer_write.swap_items(conn, account, instance_id, target_instance_id)


# ------------------------------------------------------------------ كمية بالضبط للشنطة
def fill_takes(stacks, want, cap=0):
    """الخطة اللي توصلّل الرقم بالضبط: رصّات كاملة الأول، والفاضل ينفصل من أقرب رصة أكبر.

    بترجّع [{"instance_id", "amount", "partial"}] أو None لو المتاح كله أقل من الرقم.
    السقف بيقسّم الفاضل chunks ما بتعديش حجم الأكوم، فالشنطة تستقبل رصّتين زي اللعبة
    بالظبط (15 + 2 للرقم 17) بدل ما ترفض قطعة أكبر من الحد.
    """
    pool = [{"instance_id": str(s.get("instance_id") or ""), "amount": int(s.get("amount") or 0)}
            for s in (stacks or []) if str(s.get("instance_id") or "")]
    pool = [s for s in pool if s["amount"] > 0]
    left = int(want or 0)
    if left < 1 or not pool or sum(s["amount"] for s in pool) < left:
        return None
    pool.sort(key=lambda s: (-s["amount"], s["instance_id"]))
    takes = []
    # الرصّة اللي حجمها ما يزيدش عن المطلوب ومكانها هي الأولى: نقلها في طلب واحد
    # أحسن من رصّات صغيرة + فصل من رصّة تانية. قبل كده كان الرصّات الصغيرة (2)
    # بتتملي الأول مع إن رصّة 5 بتغطي الرقم في حركة واحدة.
    best_i, best_cost = -1, None
    for i, s in enumerate(pool):
        if s["amount"] > left:
            continue
        rem = left - s["amount"]
        cost = 0 if rem == 0 else None
        if rem > 0:
            chunk = min(rem, cap) if cap and cap > 1 else rem
            if any(x["amount"] > chunk for x in pool if x is not s):
                cost = 1
        if cost is not None and (best_cost is None or cost < best_cost):
            best_i, best_cost = i, cost
            if cost == 0:
                break
    if best_i >= 0:
        s = pool[best_i]
        takes.append({"instance_id": s["instance_id"], "amount": s["amount"], "partial": False})
        left -= s["amount"]
        s["amount"] = 0
    for s in pool:
        if left <= 0:
            break
        if s["amount"] <= left and s["amount"] > 0:
            takes.append({"instance_id": s["instance_id"], "amount": s["amount"], "partial": False})
            left -= s["amount"]
            s["amount"] = 0     # الرصة اتنقلت كلها: مابقاش فيها حاجة تتفصل
    while left > 0:
        chunk = min(left, cap) if cap and cap > 1 else left
        # أقرب رصة للقطعة المطلوبة: بنفضّي أصغر رصة ممكنة عشان الكبيرة تفضل سليمة
        cands = [s for s in pool if s["amount"] > chunk]
        if not cands:
            return None
        s = min(cands, key=lambda x: (x["amount"], x["instance_id"]))
        takes.append({"instance_id": s["instance_id"], "amount": chunk, "partial": True})
        s["amount"] -= chunk
        left -= chunk
    return takes


def _merge_undo(dst, cells):
    """حالة الخانات الأصلية من خطوات كتابة كتير: أول قراية لكل خانة هي الصح."""
    for cell, kids in (cells or {}).items():
        dst.setdefault(cell, kids)
    return dst


def _merge_backpack(conn, account, asset_id, cap, keep_id="", max_rounds=8):
    """يجمع قطع النوع الواحد اللي في الشنطة في كومة واحدة على البوابة.

    السحب بيفصل القطع في خانات ورا بعضها (الرصّات الكاملة الأول والقطعة المفصولة
    بعدها)، فلو الطلب 2 بيوصلوا قطعتين 1 + 1. الدمج الحقيقي مفتوح على مسار
    batch-operation (moveAmount لمعرّف كومة موجودة) — نفس اللي في زر MERGE —
    فبنستخدمه على اللي وصل للشنطة بدل ما نستنى اللعبة تلمّها.

    بيرجّع {"merged": عدد الدمجات الناجحة, "id": معرّف الكومة النهائية,
            "amount": كميتها, "detail": آخر رسالة} — ومابيرميش استثناء أبداً:
    فشل الدمج مش فشل للسحبة، القطع موجودة بس في خانات منفصلة.
    """
    merged, last_id, last_amount, detail = 0, "", 0, ""
    aid = str(asset_id or "")
    for _ in range(max(1, int(max_rounds))):
        try:
            data = pc.fetch_inventory_for(account) or {}
            tree = pioneer_tree.Tree(data.get("items") or [])
            lay = pioneer_tree.layout(tree)
        except Exception:
            break
        bag_cells = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                        for s in lay["backpack"]["slots"])
        piles = []
        for iid, node in tree.by_id.items():
            if str(node.get("gameAssetId")) != aid or node.get("slots"):
                continue
            if tree.parent.get(iid, "") not in bag_cells:
                continue
            piles.append({"id": iid, "amount": int(node.get("amount") or 0)})
        piles = [p for p in piles if p["amount"] > 0]
        if len(piles) < 2:
            if piles:
                last_id, last_amount = piles[0]["id"], piles[0]["amount"]
            break
        piles.sort(key=lambda p: (-p["amount"], p["id"] != keep_id, p["id"]))
        tgt, src = piles[0], piles[1]
        take = src["amount"]
        if cap and cap > 1:
            take = min(take, int(cap) - tgt["amount"])
        if take < 1:
            # الكومة الكبيرة مليانة للسقف: الدمج التالي على أحدث كومة أقل من السقف.
            rest = [p for p in piles[1:] if not cap or p["amount"] < int(cap)]
            if len(rest) < 2:
                last_id, last_amount = tgt["id"], tgt["amount"]
                break
            rest.sort(key=lambda p: (-p["amount"], p["id"]))
            tgt, src = rest[0], rest[1]
            take = min(src["amount"], int(cap) - tgt["amount"]) if cap else src["amount"]
            if take < 1:
                last_id, last_amount = tgt["id"], tgt["amount"]
                break
        out = pioneer_write.combine_attempt(conn, account, src["id"], tgt["id"],
                                            amount=take, cap=cap)
        detail = out.get("detail") or ""
        if not out.get("executed"):
            break
        merged += 1
        last_id = tgt["id"]
        last_amount = int((out.get("after") or {}).get("target") or (tgt["amount"] + take))
    if not last_id:
        try:
            data = pc.fetch_inventory_for(account) or {}
            tree = pioneer_tree.Tree(data.get("items") or [])
            lay = pioneer_tree.layout(tree)
            bag_cells = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                            for s in lay["backpack"]["slots"])
            best = [i for i, n in tree.by_id.items()
                    if str(n.get("gameAssetId")) == aid
                    and tree.parent.get(i, "") in bag_cells]
            if best:
                last_id = best[0]
                last_amount = int(tree.by_id[last_id].get("amount") or 0)
        except Exception:
            pass
    return {"merged": merged, "id": last_id, "amount": last_amount, "detail": detail}


_IN_USE = set()
_USE_LOCK = threading.Lock()


class _FillBusy(Exception):
    pass


@contextlib.contextmanager
def _fill_slot(account):
    """قفل الحساب: ضغطتين ورا بعض على نفس الحساب مش بيمشوا متوازيين على البوابة."""
    with _USE_LOCK:
        if account in _IN_USE:
            raise _FillBusy()
        _IN_USE.add(account)
    try:
        yield
    finally:
        with _USE_LOCK:
            _IN_USE.discard(account)


def _fill_pace():
    """فاصل هادي بين طلبات الكتابة على البوابة (400-500ms مختلطين)."""
    time.sleep(random.uniform(0.4, 0.5))


def fill_plan(stacks, want, cap=0):
    """خطة QTY بالظبط: أكوام كاملة الأول، والباقي rem تغطيه كومة واحدة.

    الرصّة المغطية بتتنقل كاملة للشنطة وتتفصل جوّاها: بيفضل منها cover - rem في
    الشنطة وقطعة rem في خانة تانية. يعني Person ده محتاج 3 خانات في الشنطة
    (المغطية + المتبقي + المنفصل) ومش محتاج ولا خانة في الستاش زي قبل كده.
    """
    pool = [{"instance_id": str(s.get("instance_id") or ""), "amount": int(s.get("amount") or 0)}
            for s in (stacks or []) if str(s.get("instance_id") or "")]
    pool = [s for s in pool if s["amount"] > 0]
    left = int(want or 0)
    if left < 1 or not pool or sum(s["amount"] for s in pool) < left:
        return None
    pool.sort(key=lambda s: (-s["amount"], s["instance_id"]))
    full, used = [], set()
    for s in pool:
        if s["amount"] <= left:
            full.append(s)
            used.add(s["instance_id"])
            left -= s["amount"]
            if left == 0:
                break
    cover, rem, split = None, left, False
    if left > 0:
        cands = [s for s in pool if s["instance_id"] not in used and s["amount"] > left]
        if not cands:
            return None
        cover = min(cands, key=lambda s: (s["amount"], s["instance_id"]))
        rem = left
        split = int(cover["amount"]) > rem
    cells = len(full)
    if cover:
        cells += 1
        if split:
            cells += 1 + (1 if int(cap or 0) and rem > int(cap) else 0)
    return {"full": full, "cover": cover, "rem": rem, "split": split, "cells": cells}


class _FillBox(object):
    """الشجرة الحية بوصف مختصر: الشنطة، الستاش، وخانات كل حاوية."""

    def __init__(self, tree, cap=0):
        self.tree = pioneer_tree.Tree(tree.items) if tree is not None else None
        lane = pioneer_tree.layout(self.tree) if self.tree is not None else {}
        self.bag = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                       for s in (lane.get("backpack") or {}).get("slots") or [])
        self.stash = set(str(s.get("wrapper") if isinstance(s, dict) else s)
                         for s in (lane.get("stash") or {}).get("slots") or [])
        self.cap = int(cap or 0)
        self.cells = set(self.tree.by_id) if self.tree is not None else set()

    def in_bag(self, iid):
        """(خانة الشنطة اللي القطعة جوّاها أو حاويتها، هل مساحة القطعة جوّه الشنطة)."""
        cur = str(iid or "")
        for _ in range(12):
            if cur in self.bag:
                return cur, True
            par = str(self.tree.parent.get(cur) or "")
            if not par:
                return "", False
            if par in self.bag:
                return par, True
            if par not in self.cells:
                return par, False
            cur = par
        return "", False

    def seat(self, iid):
        """الخانة اللي القطعة قاعد فيها (المصدر أو خزان القطعة)."""
        par = str(self.tree.parent.get(str(iid)) or "")
        return par if par else str(iid)

    def free_bag(self):
        return [c for c in sorted(self.bag) if not self.tree.first_child(c)]

    def seat_room(self, cell):
        """هل الخانة بتستوعب قطعة فصل جديدة (رصة + قطعة أو طفل فاضي)."""
        if not cell or cell not in self.cells:
            return not cell
        kids = self.tree.children(cell)
        if not kids:
            return self.cap != 1
        return bool(self.cap) and sum(
            max(0, self.cap - int((self.tree.by_id.get(k) or {}).get("amount") or 0))
            for k in kids) > 0

    def owned(self, iid):
        """الخانة اللي نوع القطعة منسوبة لخزنه: الخانة نفسها أو خزنه المباشر."""
        return self.seat(iid) in self.stash or self.seat(iid) in self.bag

    def amount(self, iid):
        return int((self.tree.by_id.get(str(iid)) or {}).get("amount") or 0)

    def of_type(self, aid, want=0):
        """(القطع اللي في الشنطة، الأكوام في الستاش/الأوفر، القطع المنفردة، الحاوية)."""
        bags, stacks, pieces, locked = [], [], [], []
        for iid, node in self.tree.by_id.items():
            if str(node.get("gameAssetId")) != str(aid):
                continue
            qty = int(node.get("amount") or 0)
            if qty < 1:
                continue
            where, inside = self.in_bag(iid)
            if inside:
                bags.append({"instance_id": iid, "amount": qty, "cell": where,
                             "name": self.tree.name_of(iid)})
                continue
            seat = self.seat(iid)
            item = {"instance_id": iid, "amount": qty, "cell": seat,
                    "container": "stash" if seat in self.stash else "overflow",
                    "slots": bool(node.get("slots")),
                    "name": self.tree.name_of(iid)}
            if seat and seat not in self.stash:
                sealed = any(self.tree.first_child(k) for k in self.tree.children(iid))
                if not sealed:
                    locked.append(item)
                    continue
            if qty > 1 and not item["slots"]:
                stacks.append(item)
            else:
                pieces.append(item)
        return bags, stacks, pieces, locked


def _fill_read(conn, account, asset_id, want, in_bag):
    """قراية حية واحدة للشجرة: الشنطة، والستاش/الأوفر للنوع ده، والخانات الفاضية."""
    data = pc.fetch_inventory_for(account)
    tree = pioneer_tree.Tree((data or {}).get("items") or [])
    pioneer_tree.layout(tree)
    box = _FillBox(tree, _stack_cap(conn, account, str(asset_id)))
    bags, stacks, pieces, locked = box.of_type(asset_id, want)
    total = sum(b["amount"] for b in bags)
    return {"data": data, "tree": tree, "box": box, "bag_cells": box.bag,
            "stash_cells": box.stash, "free": box.free_bag(), "bag_stacks": bags,
            "stacks": stacks, "pieces": pieces, "locked": locked,
            "in_bag": total if total else int(in_bag or 0)}


def _fill_plan_of(found, want, cap):
    """الخطة الرسمية: كل اللي بيتنقل كامل في طلب واحد، وكسر واحد آخره بيتفصل.

    • الناقص بيتاخد من الستاش/الأوفر: الأكوام الكبيرة كاملة، وآخر كومة (أو قطعة)
      فيها الكسر بتتفصل جوّه الشنطة.
    • لو الستاش مش مكفي: أكبر كومة في الشنطة بتكمّل التغطية وبتتفصل برضه.
    • مكان الفصل: كومة خانتها فيها مساحة الأول؛ لو كل الأكوام مسدودة (رصّة على
      قد الخانة) الكسر بيتعمل على قطعة منفردة كاملة بدالها.
    • قطع خانات التجهيز/السلاح مش مصادر فصل — بتتحسب في الإجمالي بس.
    """
    box = found["box"]
    bags = found["bag_stacks"]
    stacks = sorted([s for s in found["stacks"] if s["amount"] > 1],
                    key=lambda s: (0 if s["container"] == "stash" else 1,
                                   -s["amount"], s["instance_id"]))
    loose = sorted([s for s in found["stacks"] if s["amount"] <= 1] + found["pieces"],
                   key=lambda s: (-s["amount"], 0 if s["container"] == "stash" else 1,
                                  s["instance_id"]))
    roomy = [s for s in stacks if box.seat_room(s["cell"])]
    if not roomy and loose:
        stacks, loose = [], sorted(stacks + loose,
                                   key=lambda s: (-s["amount"],
                                                  0 if s["container"] == "stash" else 1,
                                                  s["instance_id"]))
    need = want - found["in_bag"]
    out = {"need": need, "want": want, "short": 0, "items": [], "cells": 0, "plan": None}
    keep_side = max(0, found["in_bag"] - want)
    source = sum(s["amount"] for s in stacks) + sum(s["amount"] for s in loose)
    if need <= 0:
        if not keep_side:
            return out
        # الشنطة فيها أكتر من المطلوب: الزيادة بتخرج من أكبر كومة جوّاها.
        big = sorted([b for b in bags if b["amount"] > 1], key=lambda b: -b["amount"])
        if not big:
            out["short"] = keep_side
            return out
        out["cells"] = 2
        out["plan"] = {"items": [big[0]], "tail": dict(big[0], side="remove"),
                       "split": True, "group": True, "keep": want, "cells": 2}
        return out
    short = need - source
    if short > 0:
        # أكبر كومة في الشنطة بتكمّل الناقص وبتتفصل برضه.
        big = sorted([b for b in bags if b["amount"] > short], key=lambda b: b["amount"])
        if not big:
            out["short"] = short
            return out
        out["items"] = [dict(s, take=s["amount"], side="whole") for s in stacks + loose]
        out["items"].append(dict(big[0], take=short, side="cover"))
        out["cells"] = len(stacks) + len(loose) + 2
        out["plan"] = {"items": out["items"], "tail": out["items"][-1],
                       "split": True, "group": False, "cells": out["cells"]}
        return out
    items, left = [], need
    tail = None
    for s in stacks:
        if left <= 0:
            break
        take = min(s["amount"], left)
        if take < s["amount"]:
            tail = dict(s, take=take, side="tail", cover=True)
        else:
            items.append(dict(s, take=take, side="whole"))
        left -= take
    if left > 0:
        placed = []
        for p in loose:
            if left <= 0:
                break
            take = min(p["amount"], left)
            if take < p["amount"]:
                tail = dict(p, take=take, side="tail", cover=True)
            else:
                placed.append(dict(p, take=take, side="whole"))
            left -= take
        if left > 0 and placed:
            # الكسر بقى هو نفسه قطعة كاملة: بيتحوّل لقطعة كبيرة تتفصل منها.
            big = [b for b in bags if b["amount"] > left]
            if big:
                tail = dict(min(big, key=lambda b: b["amount"]), take=left, side="cover")
                left = 0
        items.extend(placed)
    if left > 0:
        out["short"] = left
        return out
    whole = [e for e in items if e["side"] == "whole"]
    if tail:
        out["cells"] = len(whole) + (2 if tail.get("cover") else 1)
    elif keep_side:
        # الزيادة أصلاً جوّه الشنطة: أكبر كومة بتترجع جزء منها.
        big = sorted([b for b in bags if b["amount"] > keep_side], key=lambda b: -b["amount"])
        if not big:
            out["short"] = keep_side
            return out
        tail = dict(big[0], take=big[0]["amount"] - keep_side, side="tail")
        out["cells"] = len(whole)
    else:
        out["cells"] = len(whole)
    out["items"] = items
    out["plan"] = {"items": items, "tail": tail, "split": bool(tail),
                   "group": found["in_bag"] > want, "cells": out["cells"]}
    return out


def _fill_count(box, aid):
    """(إجمالي النوع كله، اللي في الشنطة) من قراية حية."""
    bags, stacks, pieces, locked = box.of_type(aid)
    total = sum(b["amount"] for b in bags) + sum(s["amount"] for s in stacks) + \
        sum(p["amount"] for p in pieces) + sum(p["amount"] for p in locked)
    return total, sum(b["amount"] for b in bags)


def _fill_verify(conn, account, asset_id, name, before, in_bag, steps, undo, plan):
    """التحقق النهائي وخطوة WAN: SYNC واحد، ونوع الإجمالي ثابت والشنطة فيها الرقم بالظبط."""
    aid = str(asset_id)
    after = pc.fetch_inventory_for(account) or {}
    box = _FillBox(pioneer_tree.Tree((after or {}).get("items") or []))
    pioneer_tree.layout(box.tree)
    now_total, bag_count = _fill_count(box, aid)
    same = now_total == before
    sync = {"ok": False, "detail": ""}
    _fill_pace()
    try:
        sync = synchronize(conn, account) or {}
    except Exception as exc:
        sync = {"ok": False, "detail": str(exc)[:200]}
    return {"executed": True, "kind": "fill", "delivered": bag_count - in_bag,
            "in_backpack": bag_count, "total_before": before, "total_after": now_total,
            "same_total": same, "plan": plan, "steps": steps, "undo": {"cells": undo},
            "sync": bool(sync.get("ok")), "refreshed": None,
            "detail": "%d %s in the backpack (was %d); the type total is %s." % (
                bag_count, name, in_bag,
                ("still %d" % before) if same else "CHANGED from %d to %d" % (before, now_total))}


def _fill_verified(conn, account, asset_id, want, confirmed):
    """تنفيذ QTY على المسارات الرسمية للبوابة:
      1) قراية حية وحساب الخانات قبل أي كتابة — النقص = رفض فوري برسالة السبب.
      2) كل اللي بيتنقل (أكوام/قطع كاملة) في طلب واحد بفاصل هادي.
      3) الكسر الوحيد بيتفصل جوّه الشنطة، والزيادة ترجع للستاش (أو الأوفر لو مليان).
      4) SYNC واحد في الآخر.
    """
    aid = str(asset_id)
    try:
        found = _fill_read(conn, account, aid, want, 0)
    except pc.TokenExpired as exc:
        return {"executed": False, "error": "token_expired", "kind": "fill", "detail": str(exc)}
    except pc.PioneerError as exc:
        return {"executed": False, "error": "gateway_error", "kind": "fill",
                "detail": str(exc)[:300]}
    except pioneer_tree.TreeError as exc:
        return {"executed": False, "error": exc.error, "kind": "fill", "detail": exc.detail}
    try:
        box = found["box"]
        name = next((s["name"] for s in found["stacks"] + found["pieces"] + found["bag_stacks"]
                     if s.get("name")), aid)
        total, _bag = _fill_count(box, aid)
        total = max(total, found["in_bag"])
        if total < want:
            return {"executed": False, "error": "not_in_stash", "kind": "fill",
                    "detail": "All you have of %s is %d (stash, overflow and backpack), so %d "
                              "is impossible." % (name, total, want)}
        if found["in_bag"] == want:
            return {"executed": False, "error": "already_in_backpack", "kind": "fill",
                    "detail": "The backpack already holds %d %s, so there is nothing to move." % (
                        found["in_bag"], name)}
        cap = box.cap
        before = total
        calc = _fill_plan_of(found, want, cap)
        plan = calc["plan"]
        if plan is None or calc["short"] > 0:
            locked = sum(p["amount"] for p in found["locked"])
            why = (" %d of them are inside equipped slots and cannot be split."
                   % locked) if locked else ""
            return {"executed": False, "error": "not_enough", "kind": "fill", "plan": plan,
                    "detail": "There is not enough of %s in the stash to reach %d exactly.%s" % (
                        name, want, why)}
        need = plan["cells"]
        if len(found["free"]) < need:
            return {"executed": False, "error": "no_room", "kind": "fill", "plan": plan,
                    "cells_needed": need, "cells_free": len(found["free"]),
                    "detail": "The backpack has %d free cells and this move needs %d. Make room "
                              "first." % (len(found["free"]), need)}
        if not confirmed:
            return {"executed": False, "error": "confirm_required", "kind": "fill", "plan": plan,
                    "detail": "This writes to the live source — explicit confirmation required."}
        if pioneer_write.paused():
            return {"executed": False, "error": "write_paused", "code": 423, "kind": "fill",
                    "plan": plan, "detail": pioneer_write.PAUSE_DETAIL}
    except Exception as exc:
        return {"executed": False, "error": "bad_tree", "kind": "fill", "detail": str(exc)[:300]}

    steps, undo = [], {}
    with _fill_slot(account):
        try:
            return _fill_steps(conn, account, found, aid, name, cap, before, calc, steps, undo)
        except pc.TokenExpired as exc:
            return {"executed": False, "error": "token_expired", "kind": "fill",
                    "plan": plan, "steps": steps, "detail": str(exc)}
        except pc.PioneerError as exc:
            return {"executed": False, "error": "gateway_error", "kind": "fill",
                    "plan": plan, "steps": steps, "detail": str(exc)[:300]}
        except pioneer_tree.TreeError as exc:
            return {"executed": False, "error": exc.error, "kind": "fill",
                    "plan": plan, "steps": steps, "detail": exc.detail}


def _fill_where(snap, iid, cells):
    """(الخانة اللي القطعة جوّاها، هل هي جوّه الشنطة) — بالطلوع في أباء الشجرة الحية."""
    if snap is None or not iid or str(iid) not in snap.by_id:
        return "", False
    cur = str(iid)
    for _ in range(12):
        if cur in cells:
            return cur, True
        par = str(snap.parent.get(cur) or "")
        if not par:
            return "", False
        if par in cells:
            return par if par in snap.by_id else cur, True
        if par not in snap.by_id:
            return par, False
        cur = par
    return "", False


def _fill_steps(conn, account, found, aid, name, cap, before, calc, steps, undo):
    """كل اللي بيتنقل كامل في طلب واحد، وبعدها الكسر الوحيد بيتفصل جوّه الشنطة.

    كل خطوة بتتأكد من الشجرة الحية قبل اللي بعدها؛ والفشل بيرجّع اللي دخل الشنطة
    ويطلع سبب البوابة الحرفي بدل الصمت."""
    plan = calc["plan"]
    items = [dict(e) for e in plan["items"]]
    tail = plan["tail"]
    want = int(plan.get("keep", calc["want"]))
    group = bool(plan.get("group"))

    def live():
        data = pc.fetch_inventory_for(account) or {}
        box = _FillBox(pioneer_tree.Tree(data.get("items") or []), cap)
        pioneer_tree.layout(box.tree)
        return box

    def stop(msg):
        return {"executed": False, "kind": "fill", "error": "move_failed", "plan": plan,
                "steps": steps, "undo": {"cells": undo}, "detail": msg}

    def back(iid):
        _fill_pace()
        out = pioneer_write.move(conn, account, "stash", [{"instance_id": iid}])
        if not out.get("executed"):
            _fill_pace()
            out = pioneer_write.move(conn, account, "overflow", [{"instance_id": iid}])
        steps.append({"action": "move", "what": "excess", "items": 1,
                      "executed": bool(out.get("executed")), "error": out.get("error"),
                      "detail": out.get("detail")})
        if live().in_bag(iid)[1]:
            return (out.get("detail") or out.get("error")
                    or "the excess piece did not leave the backpack")
        return ""

    def split_fix(box, eid, take):
        """فصل take وإخراج الزيادة من الشنطة، مع تحقق على الشجرة الحية."""
        sp = pioneer_write.split_attempt(conn, account, eid, "", take, cap=cap, into_cell=False)
        steps.append({"action": "split", "instance_id": eid, "amount": take,
                      "executed": bool(sp.get("executed")), "error": sp.get("error"),
                      "detail": sp.get("detail")})
        if not sp.get("executed"):
            return sp.get("detail") or sp.get("error") or "the split did not execute"
        box = live()
        seat = box.seat(eid)
        fresh = str(sp.get("created") or "")
        if not fresh or fresh not in box.tree.by_id:
            fresh = next((k for k in box.tree.children(seat) if k != eid), "")
        landed_in_bag = bool(fresh) and box.in_bag(fresh)[0] in box.bag
        keep_id = fresh if landed_in_bag else eid
        keep_amt = box.amount(keep_id)
        bag_now = sum(b["amount"] for b in box.of_type(aid)[0])
        if bag_now == want and keep_amt == take:
            return ""
        excess = eid if landed_in_bag else fresh
        if not excess or bag_now <= want:
            return ("The split ran but the backpack holds %d %s instead of %d."
                    % (bag_now, name, want))
        why = back(excess)
        if why:
            return why
        box = live()
        if _fill_count(box, aid)[0] != before:
            return "⚠️ The total of the type changed while the excess was going back."
        bag_now = sum(b["amount"] for b in box.of_type(aid)[0])
        if bag_now != want:
            return ("The backpack holds %d %s after the split and the excess went back "
                    "(wanted %d)." % (bag_now, name, want))
        return ""

    # 1) الشنطة فيها أكتر من المطلوب: الزيادة بتخرج من أكبر كومة جوّاها.
    if group:
        box = live()
        big = sorted([b for b in box.of_type(aid)[0] if b["amount"] > 1],
                     key=lambda b: -b["amount"])
        if not big:
            return stop("Nothing of %s could be read as one stack inside the backpack." % name)
        why = split_fix(box, big[0]["instance_id"], want)
        if why:
            return stop(why)
        return _fill_verify(conn, account, aid, name, before, found["in_bag"], steps, undo, plan)

    # 2) كل الأكوام/القطع الكاملة المطلوبة في طلب واحد.
    moving = [e for e in items if e["side"] == "whole"]
    if moving:
        body = [{"instance_id": e["instance_id"]} for e in moving]
        _fill_pace()
        out = pioneer_write.move(conn, account, "backpack", body)
        _merge_undo(undo, (out.get("undo") or {}).get("cells"))
        steps.append({"action": "move", "what": "full", "items": len(body),
                      "amount": sum(e["take"] for e in moving),
                      "executed": bool(out.get("executed")), "error": out.get("error"),
                      "detail": out.get("detail")})
        box = live()
        inside = [e for e in moving if box.in_bag(e["instance_id"])[1]]
        if not out.get("executed") or out.get("to_overflow") or len(inside) < len(moving):
            why = ""
            for e in inside:
                why = why or back(e["instance_id"])
            bad = (out.get("detail") or out.get("error")) if not out.get("executed") or \
                out.get("to_overflow") else ("the gateway answered OK but %d of the stacks did "
                                             "not show inside the backpack"
                                             % (len(moving) - len(inside)))
            return stop("%s%s" % (bad, (" — %s" % why) if why else ""))
    # 3) الكسر: الكومة بتتنقل كاملة لخانة فاضية وبتتفصل جوّاها.
    if tail:
        eid = tail["instance_id"]
        if tail["side"] == "cover" or (eid not in [e["instance_id"] for e in moving]):
            box = live()
            free = box.free_bag()
            if not free:
                return stop("The covering stack of %s has no free cell in the backpack — make "
                            "room and try again." % name)
            _fill_pace()
            out = pioneer_write.move(conn, account, "backpack",
                                     [{"instance_id": eid, "target_wrapper_id": free[0]}],
                                     fallback_if_full=True)
            _merge_undo(undo, (out.get("undo") or {}).get("cells"))
            steps.append({"action": "move", "what": "cover", "items": 1,
                          "amount": tail["take"], "executed": bool(out.get("executed")),
                          "error": out.get("error"), "detail": out.get("detail")})
            if not out.get("executed") or not live().in_bag(eid)[1]:
                return stop(out.get("detail") or out.get("error")
                            or "the covering stack did not enter the backpack")
        box = live()
        amt = box.amount(eid)
        if tail["take"] < amt:
            why = split_fix(box, eid, tail["take"])
            if why:
                return stop(why)
    return _fill_verify(conn, account, aid, name, before, found["in_bag"], steps, undo, plan)


def fill(conn, account, asset_id, want, target_wrapper="", confirmed=False):
    """يوصلّل الرقم المطلوب للشنطة بالظبط (QTY → MOVE TO BACKPACK).

    الرقم بيتقرا من الشجرة الحية، والخانات بتتحسب قبل أي كتابة. لو الخانات ناقصة
    الطلب بيترفض قبل ما يتلمس أي حاجة، ولو خطوة فشلت في النص بيرجع اللي اتسمع
    لحد ما وقف — مفيش كتابة هيكلية يدوية، كله نقل وفصل رسمي على البوابة.
    """
    if config.DATA_SOURCE != "pioneer":
        return {"executed": False, "error": "direct_read_only", "kind": "fill",
                "detail": DIRECT_BLOCK_DETAIL}
    if account == "ALL":
        return {"executed": False, "error": "pick_account", "detail": "Pick one account first."}
    if not asset_id:
        return {"executed": False, "error": "nothing_selected", "kind": "fill",
                "detail": "Select one item type in the search first."}
    try:
        want = int(want)
    except (TypeError, ValueError):
        want = 0
    if want < 1:
        return {"executed": False, "error": "bad_amount", "kind": "fill",
                "detail": "Type a number in the QTY field first."}
    try:
        return _fill_verified(conn, account, asset_id, want, confirmed)
    except _FillBusy:
        return {"executed": False, "error": "busy", "kind": "fill", "code": 409,
                "detail": "Another QTY move is already running on this account; wait for it "
                          "to finish."}
def synchronize(conn, account):
    if config.DATA_SOURCE == "pioneer":
        if account == "ALL":
            return {"executed": False, "error": "pick_account", "detail": "Pick one account to sync."}
        pulled = sync.pull_account(conn, account, None, with_assets=False)
        store.log_action(conn, account, "sync:direct", {"source": "pioneer"},
                         "executed" if pulled.get("ok") else "failed",
                         pulled.get("error") or {"items": pulled.get("items")}, 0)
        return {"executed": bool(pulled.get("ok")), "result": {"ok": True, "mode": "pioneer"},
                "refreshed": pulled, "note": "Sync came straight from the game gateway — no data went through rampart."}
    if account == "ALL":
        return {"executed": False, "error": "pick_account", "detail": "Pick one account to sync."}
    acc_id = _account_id(conn, account)
    if not acc_id:
        return {"executed": False, "error": "pick_account", "detail": "This account is not linked on Rampart."}
    try:
        outcome = writer.sync_upstream(acc_id)
    except Exception as exc:
        outcome = {"ok": False, "code": 502, "error": "upstream_error", "detail": str(exc)[:300]}
    store.log_action(conn, account, "synchronize",
                     {"method": "POST", "url": writer.SYNC},
                     "executed" if outcome.get("ok") else outcome.get("error", "failed"),
                     outcome.get("response") or outcome.get("detail"), 0)
    pulled = None
    if outcome.get("ok"):
        pulled = sync.pull_account(conn, account, acc_id, with_assets=False)
        if pulled and pulled.get("ok"):
            store.set_meta(conn, "stats:%s" % account, pulled.get("stats") or {})
            conn.execute("UPDATE accounts SET last_sync=? WHERE id=?", (time.time(), acc_id))
            conn.commit()
    return {"executed": bool(outcome.get("ok")), "result": outcome, "refreshed": pulled}
